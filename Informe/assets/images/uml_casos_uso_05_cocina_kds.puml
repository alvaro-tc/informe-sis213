@startuml uml_casos_uso_05_cocina_kds
skinparam actorStyle awesome
skinparam usecase {
    BackgroundColor #EEF4FF
    BorderColor #2563EB
    ArrowColor #1D4ED8
    FontSize 12
}
skinparam actor {
    BackgroundColor #DBEAFE
    BorderColor #2563EB
    FontSize 12
    FontStyle Bold
}
skinparam packageStyle rectangle
skinparam packageBackgroundColor #F8FAFC
skinparam packageBorderColor #94A3B8
skinparam linetype ortho

title Casos de Uso — Cocina KDS\nSistema POS Cafetería

actor "Barista / Cocina" as barista

rectangle "Sistema POS Cafetería" {
    package "Cocina KDS" {
        (Ver órdenes en KDS) as UC16
        (Actualizar estado de orden) as UC17
    }
}

barista --> UC16
barista --> UC17

UC16 ..> UC17 : <<include>>

@enduml
