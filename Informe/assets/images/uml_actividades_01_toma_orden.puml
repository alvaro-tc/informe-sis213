@startuml uml_actividades_01_toma_orden
skinparam activity {
    BackgroundColor #EEF4FF
    BorderColor #2563EB
    ArrowColor #1D4ED8
    FontSize 11
    DiamondBackgroundColor #FEF3C7
    DiamondBorderColor #D97706
}
skinparam swimlane {
    BorderColor #94A3B8
    TitleFontColor #1E3A5F
    TitleFontSize 12
    TitleFontStyle Bold
}
skinparam noteBackgroundColor #F0FDF4
skinparam noteBorderColor #16A34A
skinparam StartColor #1D4ED8
skinparam EndColor #DC2626

title Diagrama de Actividades — Toma de Orden\nSistema POS Cafetería

|Cliente|
start
:Llega a la cafetería\no contacta al cajero;
:Solicita pedido\n(en local o para llevar);

|Cajero / Mesero|
:Recibe solicitud del cliente;
if (¿Tipo de pedido?) then (En local)
    :Selecciona mesa disponible;
    :Asigna nombre del cliente\na la mesa;
else (Para llevar)
    :Registra nombre del cliente\n(sin asignar mesa);
endif

:Abre carrito de órdenes\nen el módulo de Menú;
:Agrega platos al carrito\n(cantidad e ítems);

|Sistema Backend|
:Calcula subtotal\npor ítem y total;
note right: subtotal = Σ(precio × qty)\ntax = subtotal × 0.13\ntotal = subtotal + tax

|Cajero / Mesero|
:Confirma la orden;

|Sistema Backend|
:Registra la orden en MongoDB\n(status: PENDING);
:Descuenta insumos del\ninventario automáticamente;
if (¿Stock de insumos crítico?) then (Sí)
    :Genera alerta de\nstock bajo/crítico;
endif
:Actualiza estado de mesa\na OCCUPIED (si DINE_IN);
:Notifica a la pantalla KDS;

stop

@enduml
