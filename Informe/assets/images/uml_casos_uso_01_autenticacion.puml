@startuml uml_casos_uso_01_autenticacion
skinparam actorStyle awesome
skinparam usecase {
    BackgroundColor #EEF4FF
    BorderColor #2563EB
    ArrowColor #1D4ED8
    FontSize 12
}
skinparam actor {
    BackgroundColor #DBEAFE
    BorderColor #2563EB
    FontSize 12
    FontStyle Bold
}
skinparam packageStyle rectangle
skinparam packageBackgroundColor #F8FAFC
skinparam packageBorderColor #94A3B8
skinparam linetype ortho

title Casos de Uso — Autenticación\nSistema POS Cafetería

actor "Administrador" as admin
actor "Cajero / Mesero" as cajero
actor "Barista / Cocina" as barista

rectangle "Sistema POS Cafetería" {
    package "Autenticación" {
        (Iniciar sesión) as UC01
        (Cerrar sesión) as UC02
    }
}

admin  --> UC01
admin  --> UC02
cajero --> UC01
cajero --> UC02
barista --> UC01
barista --> UC02

@enduml
