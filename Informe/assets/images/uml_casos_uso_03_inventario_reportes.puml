@startuml uml_casos_uso_03_inventario_reportes
skinparam actorStyle awesome
skinparam usecase {
    BackgroundColor #EEF4FF
    BorderColor #2563EB
    ArrowColor #1D4ED8
    FontSize 12
}
skinparam actor {
    BackgroundColor #DBEAFE
    BorderColor #2563EB
    FontSize 12
    FontStyle Bold
}
skinparam packageStyle rectangle
skinparam packageBackgroundColor #F8FAFC
skinparam packageBorderColor #94A3B8
skinparam linetype ortho

title Casos de Uso — Inventario y Reportes\nSistema POS Cafetería

actor "Administrador" as admin

rectangle "Sistema POS Cafetería" {
    package "Inventario y Reportes" {
        (Gestionar insumos) as UC07
        (Ver alertas de stock) as UC08
        (Ver métricas y reportes) as UC09
    }
}

admin --> UC07
admin --> UC08
admin --> UC09

@enduml
